  }

  /**
   * Returns whether a point is inside the region "Area do centro".
   *
   * <p>Field-fixed: the same physical area on both alliances.
   */
  public static boolean isInAreaDoCentro(Translation2d point) {
    double x = point.getX();
    double y = point.getY();
    return (inPolygon(x, y, POLYGON_1_0_X, POLYGON_1_0_Y))
        && !(inPolygon(x, y, POLYGON_1_1_X, POLYGON_1_1_Y));
  }

  /**
   * Returns whether a robot pose is inside the region "source-lane".
