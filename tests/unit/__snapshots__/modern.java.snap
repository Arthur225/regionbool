  private FieldRegions() {}

  /**
   * Returns whether a robot pose is inside the region "Scoring Zone".
   *
   * <p>Alliance-relative: drawn from blue's side and flipped when on red. An unknown alliance counts as blue.
   */
  public static boolean isInScoringZone(Pose2d pose) {
    return isInScoringZone(pose.getTranslation());
  }

  /**
   * Returns whether a point is inside the region "Scoring Zone".
   *
   * <p>Alliance-relative: drawn from blue's side and flipped when on red. An unknown alliance counts as blue.
   */
  public static boolean isInScoringZone(Translation2d point) {
    double x = point.getX();
    double y = point.getY();
    if (isRedAlliance()) {
      x = FIELD_LENGTH_METERS - x;
    }
    return (inRect(x, y, 3.0, 4.0, 2.0, 1.0, 0.8660254037844387, 0.49999999999999994)
        || inCircle(x, y, 5.0, 6.0, 1.25))
        && !(inCircle(x, y, 3.0, 4.0, 0.5));
  }

  /**
   * Returns whether a robot pose is inside the region "Area do centro".
   *
   * <p>Field-fixed: the same physical area on both alliances.
   */
  public static boolean isInAreaDoCentro(Pose2d pose) {
